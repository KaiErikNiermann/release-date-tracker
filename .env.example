# Copy to .env and fill in. .env is gitignored.
#
# This file still works, but it is no longer the primary place for settings: `s` in the TUI
# and `rdt config set` write ~/.config/rdt/config.toml, which is read above this file.
# `rdt doctor` shows what is set and where it came from.

# --- LLM gap-filler (Tier 1) ---
OPENAI_API_KEY=sk-...
# Low-cost model with structured-output support. Override as you like.
OPENAI_MODEL=gpt-4o-mini

# --- The Movie Database (movies / TV). Free: https://www.themoviedb.org/settings/api ---
# Copy the "API Key (v3 auth)" — NOT the "API Read Access Token" (v4). We authenticate with
# the v3 key as a query parameter, so the v4 JWT just fails with a 401.
TMDB_API_KEY=

# --- IGDB (games), via Twitch: https://dev.twitch.tv/console/apps ---
# Register an application with Client Type = Confidential; a Public app is never issued a
# secret. Needs 2FA on the Twitch account. Free for non-commercial use.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Notion seed (optional; only needed for the live Notion seed provider) ---
# Create an internal integration, share the DB with it: https://www.notion.so/my-integrations
NOTION_TOKEN=
NOTION_DATABASE_ID=

# --- defaults ---
# Comma-separated ISO 3166-1 alpha-2 regions to prioritise when resolving dates/prices.
RDT_REGIONS=US,DE,GB
# Leave RDT_DB_PATH unset to use the XDG location (~/.local/share/rdt/releases.db).
# `rdt doctor` prints where it actually resolved.
