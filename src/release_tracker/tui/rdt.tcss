Screen {
    background: $surface;
}

/* Laid out top-to-bottom by the screen's default vertical layout — NOT docked.
   Docking several widgets to the same edge overlaps them rather than stacking them,
   which previously painted the hint line straight over the query text. */
#query {
    height: 1;
    border: none;
    background: $panel;
    padding: 0 1;
}

#query:focus {
    background: $panel-lighten-1;
}

#hint {
    height: 1;
    padding: 0 1;
    color: $text-muted;
    background: $panel;
}

#rows {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#status {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

CardScreen {
    align: center middle;
}

#card {
    width: 84;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#card-title {
    text-style: bold;
    padding-bottom: 1;
}

StateToggle {
    height: 3;
    padding: 1 0;
}

StateToggle:focus {
    border-left: thick $accent;
}

#card-body {
    height: auto;
    max-height: 20;
    overflow-y: auto;
}

AddScreen {
    align: center middle;
}

#add {
    width: 96;
    max-width: 95%;
    height: 24;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#add-status {
    height: 1;
    color: $text-muted;
}

#candidates {
    height: 1fr;
    border: none;
}

/* --- the card in edit mode ------------------------------------------------
   Same box as #card, so `e` reads as the card becoming writable rather than as
   a different screen opening over it. */
EditScreen {
    align: center middle;
}

#edit {
    width: 84;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#edit-title {
    padding-bottom: 1;
}

#edit-body {
    height: auto;
    max-height: 24;
    overflow-y: auto;
}

.edit-head {
    text-style: bold;
    padding-top: 1;
}

.edit-row {
    height: 1;
}

/* One label column across every section, so the fields line up as a form. */
.row-label, .edit-row > Cycle {
    width: 20;
    padding-right: 1;
}

.edit-row > Cycle:focus {
    background: $panel-lighten-1;
}

.edit-row > Input {
    width: 1fr;
    height: 1;
    border: none;
    background: $panel;
    padding: 0 1;
}

.edit-row > Input:focus {
    background: $panel-lighten-1;
}

.note-row {
    height: auto;
    padding: 0 1;
}

.note-row:focus {
    background: $panel-lighten-1;
}

#edit-hint {
    height: 1;
    color: $text-muted;
}

#edit-foot, #edit-status {
    height: 1;
    color: $text-muted;
}
