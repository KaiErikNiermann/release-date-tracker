Screen {
    background: $surface;
}

/* Laid out top-to-bottom by the screen's default vertical layout — NOT docked.
   Docking several widgets to the same edge overlaps them rather than stacking them,
   which previously painted the hint line straight over the query text. */
#query {
    height: 1;
    border: none;
    background: $panel;
    padding: 0 1;
}

#query:focus {
    background: $panel-lighten-1;
}

#hint {
    height: 1;
    padding: 0 1;
    color: $text-muted;
    background: $panel;
}

#rows {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#status {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

CardScreen {
    align: center middle;
}

#card {
    width: 84;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#card-title {
    text-style: bold;
    padding-bottom: 1;
}

StateToggle {
    height: 3;
    padding: 1 0;
}

StateToggle:focus {
    border-left: thick $accent;
}

/* Bodies are capped in *viewport* units, not rows. A modal is `height: auto` inside a
   `max-height: 90%`, so when the terminal shrinks the modal clamps but an auto-height child
   keeps its content height and overflows — pushing the docked chrome past the bottom edge.
   A vh cap makes the body shrink with the window instead, and it is low enough here that on
   a roomy terminal `auto` still wins and the dialog stays the size of its content. */
#card-body {
    height: auto;
    max-height: 60vh;
    overflow-y: auto;
}

/* The key bar is docked, not flowed. A modal is `height: auto` up to a `max-height`, so on
   a short terminal the scrolling body claims the space and the last child in the flow gets
   laid out past the bottom edge — the keys vanish exactly when the window is too small to
   guess them from. Docking reserves the row first, and the body scrolls in what is left. */
#card-foot {
    dock: bottom;
}

AddScreen {
    align: center middle;
}

#add {
    width: 96;
    max-width: 95%;
    height: 24;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#add-status {
    height: 1;
    color: $text-muted;
}

#candidates {
    height: 1fr;
    border: none;
}

/* --- the card in edit mode ------------------------------------------------
   Same box as #card, so `e` reads as the card becoming writable rather than as
   a different screen opening over it. */
EditScreen {
    align: center middle;
}

#edit {
    width: 96;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#edit-title {
    padding-bottom: 1;
}

/* The one screen that flexes rather than sizing to content: the form is long enough to
   scroll on any real terminal, so filling the modal costs nothing and `1fr` guarantees the
   chrome fits at every size. */
#edit-body {
    height: 1fr;
    max-height: 60vh;
    overflow-y: auto;
}

.edit-head {
    text-style: bold;
    padding-top: 1;
}

.edit-row {
    height: 1;
}

/* One label column across every section, so the fields line up as a form. */
.row-label, .edit-row > Cycle {
    width: 20;
    padding-right: 1;
}

.edit-row > Cycle:focus {
    background: $panel-lighten-1;
}

.edit-row > Input {
    width: 1fr;
    height: 1;
    border: none;
    background: $panel;
    padding: 0 1;
}

.edit-row > Input:focus {
    background: $panel-lighten-1;
}

/* The right-hand column on a date row: what was pulled, which side is showing, and why.
   Fixed width so the fields stay aligned as a form; it truncates rather than reflowing,
   because a date row that grew to two lines would break the ↓/↑ walk. */
.row-note {
    width: 46;
    padding-left: 1;
    text-overflow: ellipsis;
}

.note-row {
    height: auto;
    padding: 0 1;
}

.note-row:focus {
    background: $panel-lighten-1;
}

#edit-hint {
    height: 1;
    color: $text-muted;
}

#edit-foot, #edit-status {
    height: 1;
    color: $text-muted;
}

/* The review-before-add form. Same shape as #edit — it is the same rows — but shorter,
   because a draft has only the handful of fields we could infer. */
#draft {
    width: 84;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#draft-title {
    padding-bottom: 1;
}

#draft-body {
    height: auto;
    max-height: 25vh;
    overflow-y: auto;
}

#draft-foot, #draft-status {
    height: 1;
    color: $text-muted;
}

/* Provenance is one line per inference that fired, so it has to grow — a prefill nobody can
   account for is worse than no prefill, and a clipped explanation is the same thing. But it is
   docked chrome, so unbounded growth pushes the key bar off a short terminal: it scrolls past a
   share of the window rather than taking the whole thing. */
#draft-lineage {
    height: auto;
    max-height: 20vh;
    overflow-y: auto;
    color: $text-muted;
}


/* The settings form. Same shape as #edit — same rows — and the same docked chrome, so the
   key bar survives a small window. */
SettingsScreen {
    align: center middle;
}

#settings {
    width: 106;
    max-width: 96%;
    height: auto;
    max-height: 90%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#settings-title {
    padding-bottom: 1;
}

#settings-body {
    height: 1fr;
    max-height: 60vh;
    overflow-y: auto;
}

#settings-chrome {
    dock: bottom;
    height: auto;
}

#settings-hint, #settings-foot, #settings-status {
    height: 1;
    color: $text-muted;
}
